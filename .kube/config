# Kubeconfig template rendered by CI with envsubst. Authenticates as the
# namespace-scoped ServiceAccount ondota/ondota-deployer (deploy/ci/deployer.yaml).
apiVersion: v1
kind: Config
clusters:
  - name: default
    cluster:
      certificate-authority-data: $KUBERNETES_CA_DATA
      server: $KUBERNETES_CLUSTER_SERVER_URL
contexts:
  - name: default
    context:
      cluster: default
      namespace: ondota
      user: ondota-deployer
current-context: default
preferences: {}
users:
  - name: ondota-deployer
    user:
      token: $KUBERNETES_TOKEN
